# Copie para .env e ajuste.

# bedrock = Amazon Nova Pro de verdade | fake = roteiro fixo para desenvolver a interface sem AWS
LLM_PROVEDOR=fake

# --- Amazon Bedrock (Nova Pro) ---
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Credenciais: use AWS_PROFILE (aws configure) ou as três variáveis abaixo. Nunca suba o .env para o git.
# AWS_PROFILE=hackathon
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
MAX_TOKENS=1500

# --- MCP ---
# Arquivo com a lista de servidores MCP. mcp_servers.json aponta para o mock local;
# mcp_servers.ifood.json é o modelo para os 4 MCPs reais do iFood.
MCP_SERVERS_FILE=mcp_servers.json
# Usado dentro do mcp_servers.ifood.json como ${IFOOD_MCP_TOKEN}
# IFOOD_MCP_TOKEN=

# --- Agente ---
MAX_PASSOS=12
LIMITE_RESULTADO_TOOL=12000

# --- Web ---
CORS_ORIGINS=http://localhost:5173
DB_PATH=data/eventos.db
