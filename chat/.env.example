# Opcional. A transcrição é local e NÃO precisa de chave de API.
# Depois de alterar o modelo, execute npm run setup:audio e reinicie o servidor.
WHISPER_MODEL=base
# Opcional: caminho para Python 3.10 a 3.13, usado somente na instalação.
# PYTHON_EXECUTABLE=C:/caminho/para/python.exe

# Agente (server/agent.mjs): usa o Claude Code instalado e logado nesta máquina, com o MCP do iFood.
# Modelo: haiku (mais rápido e barato) ou sonnet (respostas mais caprichadas).
CLAUDE_MODEL=haiku
# Opcional: localização fixa usada só quando o navegador não envia o GPS do cliente.
# Sem estas linhas, o agente pergunta o endereço no chat.
# USER_LATITUDE=-22.8184
# USER_LONGITUDE=-47.0647
